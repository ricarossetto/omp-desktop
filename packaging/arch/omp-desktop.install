post_install() {
	# O pacote já instala chrome-sandbox 4755. Reaplicar aqui protege contra
	# ferramentas que normalizam permissões durante a instalação.
	chmod 4755 /opt/omp-desktop/chrome-sandbox || true
	update-desktop-database -q /usr/share/applications 2>/dev/null || true
	update-mime-database /usr/share/mime 2>/dev/null || true
}

post_upgrade() {
	post_install
}

post_remove() {
	update-desktop-database -q /usr/share/applications 2>/dev/null || true
	update-mime-database /usr/share/mime 2>/dev/null || true
}
